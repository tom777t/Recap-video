{
  "language": "en",
  "duration": 6072.96,
  "model": "small",
  "segments": [
    {
      "start": 317.33,
      "end": 321.94,
      "text": "like today scattered among the shore."
    },
    {
      "start": 322.04,
      "end": 329.45,
      "text": "What do we do on here, Marcus?"
    },
    {
      "start": 329.55,
      "end": 335.64,
      "text": "Checking up on an old friend."
    },
    {
      "start": 335.74,
      "end": 344.65,
      "text": "Goodbye, Johnny."
    },
    {
      "start": 344.75,
      "end": 380.87,
      "text": "So I'm here, please."
    },
    {
      "start": 392.42,
      "end": 393.32,
      "text": "Here you go. Good night."
    },
    {
      "start": 393.42,
      "end": 426.52,
      "text": "Thanks."
    },
    {
      "start": 426.62,
      "end": 428.62,
      "text": "I'm sorry I can't be there for you,"
    },
    {
      "start": 428.85,
      "end": 432.15,
      "text": "but you still need something, someone to love."
    },
    {
      "start": 432.6,
      "end": 436.45,
      "text": "So start with this, because the card doesn't count."
    },
    {
      "start": 436.55,
      "end": 439.1,
      "text": "I love you, John."
    },
    {
      "start": 439.33,
      "end": 441.73,
      "text": "This illness has loomed over us for a long time,"
    },
    {
      "start": 441.83,
      "end": 443.93,
      "text": "and now that I have found my peace,"
    },
    {
      "start": 444.03,
      "end": 447.28,
      "text": "find yours until that day."
    },
    {
      "start": 447.38,
      "end": 449.78,
      "text": "Your best friend, Helen."
    },
    {
      "start": 540.06,
      "end": 542.08,
      "text": "I'm up. I'm up."
    },
    {
      "start": 563.24,
      "end": 595.58,
      "text": "Hey, we'll grab you some kibble later."
    },
    {
      "start": 596.61,
      "end": 662.22,
      "text": "You're not going to get any better."
    },
    {
      "start": 662.32,
      "end": 664.89,
      "text": "Your sister, again?"
    },
    {
      "start": 664.99,
      "end": 668.18,
      "text": "I'm going to hell with that."
    },
    {
      "start": 669.37,
      "end": 671.63,
      "text": "Take the cigarettes, you bastard."
    },
    {
      "start": 671.73,
      "end": 685.71,
      "text": "Give me three cigarettes after the fight."
    },
    {
      "start": 685.81,
      "end": 689.44,
      "text": "Nice ride."
    },
    {
      "start": 689.54,
      "end": 693.62,
      "text": "Mustang, class 429."
    },
    {
      "start": 693.72,
      "end": 694.95,
      "text": "She's 70."
    },
    {
      "start": 695.05,
      "end": 696.15,
      "text": "69."
    },
    {
      "start": 696.41,
      "end": 697.89,
      "text": "Ah."
    },
    {
      "start": 697.99,
      "end": 699.29,
      "text": "Beautiful car."
    },
    {
      "start": 699.29,
      "end": 703.72,
      "text": "Thanks."
    },
    {
      "start": 703.82,
      "end": 705.1,
      "text": "How much?"
    },
    {
      "start": 705.2,
      "end": 706.69,
      "text": "Excuse me."
    },
    {
      "start": 706.79,
      "end": 709.3,
      "text": "How much for the car?"
    },
    {
      "start": 709.4,
      "end": 714.03,
      "text": "She's off for sale."
    },
    {
      "start": 714.13,
      "end": 716.03,
      "text": "Oh, I love dogs."
    },
    {
      "start": 716.13,
      "end": 720.38,
      "text": "We'll see what's up with you, son."
    },
    {
      "start": 720.48,
      "end": 724.07,
      "text": "Oh, what is up with you?"
    },
    {
      "start": 724.17,
      "end": 728.25,
      "text": "What are you talking about?"
    },
    {
      "start": 728.35,
      "end": 840.06,
      "text": "You have good-"
    },
    {
      "start": 840.16,
      "end": 857.03,
      "text": "You need to go."
    },
    {
      "start": 857.13,
      "end": 867.59,
      "text": "I hope."
    },
    {
      "start": 867.69,
      "end": 874.08,
      "text": "Where the hell are you going?"
    },
    {
      "start": 874.18,
      "end": 876.28,
      "text": "I don't have a fucking dog!"
    },
    {
      "start": 887.1,
      "end": 888.5,
      "text": "You found the dog?"
    },
    {
      "start": 890.07,
      "end": 891.3,
      "text": "Uh-huh."
    },
    {
      "start": 891.4,
      "end": 892.5,
      "text": "There he is."
    },
    {
      "start": 904.09,
      "end": 905.29,
      "text": "Sleep tight."
    },
    {
      "start": 905.29,
      "end": 1005.66,
      "text": "I'm going to kill you."
    },
    {
      "start": 1005.76,
      "end": 1011.99,
      "text": "Yo, Relio."
    },
    {
      "start": 1012.09,
      "end": 1014.49,
      "text": "I want a new bid number and some clean papers."
    },
    {
      "start": 1014.59,
      "end": 1017.17,
      "text": "Where'd you get that car?"
    },
    {
      "start": 1017.27,
      "end": 1083.68,
      "text": "It was."
    },
    {
      "start": 1085.92,
      "end": 1087.32,
      "text": "I asked you where the hell did you get it?"
    },
    {
      "start": 1087.42,
      "end": 1089.68,
      "text": "Who gives a shit?"
    },
    {
      "start": 1089.78,
      "end": 1091.68,
      "text": "Joseph Tarasov, Nick did."
    },
    {
      "start": 1092.65,
      "end": 1094.05,
      "text": "Legal, son."
    },
    {
      "start": 1100.23,
      "end": 1101.63,
      "text": "All right, get out of here. Just get out of my shop."
    },
    {
      "start": 1101.73,
      "end": 1102.63,
      "text": "Get out right now."
    },
    {
      "start": 1102.73,
      "end": 1104.13,
      "text": "You just lose your shit, Relio?"
    },
    {
      "start": 1104.23,
      "end": 1106.13,
      "text": "Because we own you."
    },
    {
      "start": 1106.23,
      "end": 1112.86,
      "text": "Wait, what did you say?"
    },
    {
      "start": 1112.96,
      "end": 1114.16,
      "text": "What did you say to me?"
    },
    {
      "start": 1114.26,
      "end": 1115.66,
      "text": "We own you."
    },
    {
      "start": 1117.27,
      "end": 1118.87,
      "text": "You don't know me, punk."
    },
    {
      "start": 1119.0,
      "end": 1120.9,
      "text": "I work with your father, all right?"
    },
    {
      "start": 1120.9,
      "end": 1125.59,
      "text": "The owner of the car, did you kill him or what?"
    },
    {
      "start": 1125.69,
      "end": 1126.79,
      "text": "No."
    },
    {
      "start": 1126.89,
      "end": 1129.29,
      "text": "He sure as hell fucked up his dog."
    },
    {
      "start": 1129.39,
      "end": 1130.59,
      "text": "He fucked up his dog. That's what you did."
    },
    {
      "start": 1130.69,
      "end": 1132.59,
      "text": "He fucked up his dog."
    },
    {
      "start": 1132.69,
      "end": 1139.7,
      "text": "That's crazy shit, man."
    },
    {
      "start": 1139.8,
      "end": 1141.2,
      "text": "Oh, look at you."
    },
    {
      "start": 1141.3,
      "end": 1142.7,
      "text": "It's great."
    },
    {
      "start": 1142.8,
      "end": 1145.2,
      "text": "You're going to come into my shop and you're going to pull a gun on me."
    },
    {
      "start": 1145.3,
      "end": 1146.7,
      "text": "That's great, man."
    },
    {
      "start": 1146.8,
      "end": 1147.7,
      "text": "Come on."
    },
    {
      "start": 1147.8,
      "end": 1149.7,
      "text": "Now, you kill me right now."
    },
    {
      "start": 1149.8,
      "end": 1152.2,
      "text": "Would you get the fuck out of my shop?"
    },
    {
      "start": 1152.3,
      "end": 1160.81,
      "text": "You know what Beagle likes or doesn't like."
    },
    {
      "start": 1160.81,
      "end": 1162.71,
      "text": "I'll tell you something he's going to understand."
    },
    {
      "start": 1162.81,
      "end": 1171.77,
      "text": "You got a fucking pair on you, old man."
    },
    {
      "start": 1171.87,
      "end": 1174.27,
      "text": "Guess we'll be taking our business someplace else."
    },
    {
      "start": 1174.37,
      "end": 1179.46,
      "text": "So what are you going to do?"
    },
    {
      "start": 1179.56,
      "end": 1192.81,
      "text": "Eat a ride."
    },
    {
      "start": 1192.91,
      "end": 1212.89,
      "text": "Are you really speaking?"
    },
    {
      "start": 1212.99,
      "end": 1216.01,
      "text": "I heard you struck my son."
    },
    {
      "start": 1216.11,
      "end": 1217.01,
      "text": "Yes, sir, I did."
    },
    {
      "start": 1217.11,
      "end": 1219.01,
      "text": "May I ask why?"
    },
    {
      "start": 1219.11,
      "end": 1261.24,
      "text": "Yeah, well, because you stole John Wick's car, sir, and killed his dog."
    },
    {
      "start": 1261.34,
      "end": 1263.16,
      "text": "Pick up."
    },
    {
      "start": 1263.26,
      "end": 1264.74,
      "text": "Yep."
    },
    {
      "start": 1264.84,
      "end": 1265.74,
      "text": "They've agreed to your terms."
    },
    {
      "start": 1265.84,
      "end": 1273.32,
      "text": "I guess I could give much of a choice anyway, though, all right?"
    },
    {
      "start": 1273.42,
      "end": 1274.32,
      "text": "Congratulations."
    },
    {
      "start": 1274.32,
      "end": 1301.5,
      "text": "Have you seen my son?"
    },
    {
      "start": 1301.6,
      "end": 1302.5,
      "text": "How's your chip, kid?"
    },
    {
      "start": 1302.6,
      "end": 1305.82,
      "text": "We won't be hearing from them any time soon."
    },
    {
      "start": 1305.92,
      "end": 1306.82,
      "text": "Or ever."
    },
    {
      "start": 1306.92,
      "end": 1333.87,
      "text": "That's a nice jacket."
    },
    {
      "start": 1333.97,
      "end": 1334.87,
      "text": "Thanks."
    },
    {
      "start": 1334.97,
      "end": 1336.83,
      "text": "Yeah."
    },
    {
      "start": 1336.93,
      "end": 1347.09,
      "text": "Breathe."
    },
    {
      "start": 1347.19,
      "end": 1348.09,
      "text": "Should I go?"
    },
    {
      "start": 1348.19,
      "end": 1349.41,
      "text": "No."
    },
    {
      "start": 1349.51,
      "end": 1351.41,
      "text": "I'll take you to the Russian train station."
    },
    {
      "start": 1351.64,
      "end": 1353.54,
      "text": "There you go. English, please. Come on."
    },
    {
      "start": 1353.64,
      "end": 1355.27,
      "text": "Stay, you goddammit!"
    },
    {
      "start": 1355.37,
      "end": 1357.27,
      "text": "What did I do?"
    },
    {
      "start": 1357.37,
      "end": 1359.27,
      "text": "I got a cold."
    },
    {
      "start": 1359.37,
      "end": 1361.27,
      "text": "We did what you asked."
    },
    {
      "start": 1361.37,
      "end": 1367.28,
      "text": "No one saw shit."
    },
    {
      "start": 1367.28,
      "end": 1370.18,
      "text": "I'm not talking about Atlantic City, you know?"
    },
    {
      "start": 1370.28,
      "end": 1371.18,
      "text": "No."
    },
    {
      "start": 1371.28,
      "end": 1372.63,
      "text": "What?"
    },
    {
      "start": 1372.73,
      "end": 1373.63,
      "text": "You mean the Raleighos?"
    },
    {
      "start": 1373.73,
      "end": 1375.63,
      "text": "So I stole the fucking car!"
    },
    {
      "start": 1375.73,
      "end": 1377.63,
      "text": "Oh, fuck, Viggo!"
    },
    {
      "start": 1377.73,
      "end": 1378.63,
      "text": "Right."
    },
    {
      "start": 1378.73,
      "end": 1401.2,
      "text": "It's not what you did, son."
    },
    {
      "start": 1401.3,
      "end": 1403.2,
      "text": "It angers me, sir."
    },
    {
      "start": 1403.3,
      "end": 1405.24,
      "text": "It's who you did it to."
    },
    {
      "start": 1405.34,
      "end": 1406.24,
      "text": "Ooh."
    },
    {
      "start": 1406.34,
      "end": 1408.62,
      "text": "The fucking nobody?"
    },
    {
      "start": 1410.19,
      "end": 1411.09,
      "text": "Fucking nobody."
    },
    {
      "start": 1411.19,
      "end": 1433.26,
      "text": "He once was an associate of ours."
    },
    {
      "start": 1435.31,
      "end": 1437.21,
      "text": "We called him Baba Yaga."
    },
    {
      "start": 1437.31,
      "end": 1441.51,
      "text": "The boogeyman?"
    },
    {
      "start": 1441.61,
      "end": 1444.51,
      "text": "Well, John wasn't exactly the boogeyman."
    },
    {
      "start": 1444.61,
      "end": 1457.92,
      "text": "He was the one you said to kill the fucking boogeyman."
    },
    {
      "start": 1458.02,
      "end": 1466.65,
      "text": "John is a man of focus."
    },
    {
      "start": 1466.75,
      "end": 1471.08,
      "text": "They do know very little."
    },
    {
      "start": 1471.18,
      "end": 1476.66,
      "text": "I once saw him kill three men in a bar with a bouncer."
    },
    {
      "start": 1476.76,
      "end": 1479.07,
      "text": "Can..."
    },
    {
      "start": 1479.17,
      "end": 1496.19,
      "text": "Suddenly, one day, he asked to leave."
    },
    {
      "start": 1496.29,
      "end": 1504.36,
      "text": "It's over a woman, of course."
    },
    {
      "start": 1504.46,
      "end": 1507.58,
      "text": "I deal with him."
    },
    {
      "start": 1507.68,
      "end": 1512.54,
      "text": "I gave him an impossible task."
    },
    {
      "start": 1512.54,
      "end": 1521.9,
      "text": "Bob pulled off."
    },
    {
      "start": 1522.0,
      "end": 1523.9,
      "text": "Buddies, he buried that day."
    },
    {
      "start": 1524.0,
      "end": 1528.24,
      "text": "Layed a foundation on what we are now."
    },
    {
      "start": 1533.11,
      "end": 1539.22,
      "text": "And then my son, a few days after his wife died,"
    },
    {
      "start": 1539.32,
      "end": 1545.82,
      "text": "he stole his car, killed his fucking dog."
    },
    {
      "start": 1545.92,
      "end": 1548.01,
      "text": "Father, I can make this right."
    },
    {
      "start": 1548.11,
      "end": 1549.17,
      "text": "Oh."
    },
    {
      "start": 1549.27,
      "end": 1551.42,
      "text": "How do you plan that?"
    },
    {
      "start": 1551.52,
      "end": 1553.42,
      "text": "By finishing what I started."
    },
    {
      "start": 1553.52,
      "end": 1554.42,
      "text": "What the fuck?"
    },
    {
      "start": 1554.52,
      "end": 1556.42,
      "text": "I didn't hear a fucking word I said."
    },
    {
      "start": 1556.52,
      "end": 1558.42,
      "text": "Appa, you have sois bravo."
    },
    {
      "start": 1558.42,
      "end": 1561.48,
      "text": "My son."
    },
    {
      "start": 1563.12,
      "end": 1565.02,
      "text": "John will come for you."
    },
    {
      "start": 1565.12,
      "end": 1612.97,
      "text": "I heard about your wife."
    },
    {
      "start": 1613.07,
      "end": 1614.97,
      "text": "I'm sorry, my condolences."
    },
    {
      "start": 1615.07,
      "end": 1619.72,
      "text": "It seemed to be fate."
    },
    {
      "start": 1619.82,
      "end": 1623.52,
      "text": "Perhaps that's just bad fucking luck"
    },
    {
      "start": 1623.62,
      "end": 1625.58,
      "text": "caused her past to cross once again."
    },
    {
      "start": 1625.68,
      "end": 1638.8,
      "text": "John, let us not resort to our baser instincts"
    },
    {
      "start": 1638.9,
      "end": 1654.76,
      "text": "and handle this like civilized men to..."
    },
    {
      "start": 1654.86,
      "end": 1658.77,
      "text": "What do you say?"
    },
    {
      "start": 1658.87,
      "end": 1659.77,
      "text": "Enough."
    },
    {
      "start": 1665.6,
      "end": 1666.5,
      "text": "Tasker crew."
    },
    {
      "start": 1666.6,
      "end": 1669.26,
      "text": "How many?"
    },
    {
      "start": 1669.36,
      "end": 1671.26,
      "text": "How many do you have?"
    },
    {
      "start": 1671.26,
      "end": 1727.04,
      "text": "Good."
    },
    {
      "start": 1727.14,
      "end": 1922.6,
      "text": "Evening, John."
    },
    {
      "start": 1922.7,
      "end": 1926.24,
      "text": "Evening, Jimmy. Noise complaint."
    },
    {
      "start": 1926.34,
      "end": 1929.23,
      "text": "Noise complaint?"
    },
    {
      "start": 1929.33,
      "end": 1942.42,
      "text": "Working again?"
    },
    {
      "start": 1942.52,
      "end": 1944.42,
      "text": "No, I just sorting some stuff out."
    },
    {
      "start": 1944.52,
      "end": 1953.37,
      "text": "I'll leave you be then. Good night, John."
    },
    {
      "start": 1953.47,
      "end": 1954.37,
      "text": "Good night, Jimmy."
    },
    {
      "start": 1954.47,
      "end": 1974.67,
      "text": "Yes, John Wick, that's right."
    },
    {
      "start": 1974.77,
      "end": 1977.12,
      "text": "I'd like to make a dinner reservation for 12."
    },
    {
      "start": 1977.22,
      "end": 1999.28,
      "text": "Good to see you, John."
    },
    {
      "start": 1999.38,
      "end": 2000.7,
      "text": "Charlie."
    },
    {
      "start": 2000.8,
      "end": 2014.75,
      "text": "You look good."
    },
    {
      "start": 2014.85,
      "end": 2019.22,
      "text": "Here I had feared you'd left all this behind."
    },
    {
      "start": 2019.32,
      "end": 2063.23,
      "text": "I mean, anytime soon."
    },
    {
      "start": 2063.33,
      "end": 2079.02,
      "text": "Put a contract on John Wick."
    },
    {
      "start": 2079.12,
      "end": 2082.01,
      "text": "Too many."
    },
    {
      "start": 2082.01,
      "end": 2099.31,
      "text": "Put Yusuf in the red circle and wait."
    },
    {
      "start": 2099.41,
      "end": 2136.54,
      "text": "What do I owe this visit?"
    },
    {
      "start": 2141.22,
      "end": 2142.12,
      "text": "I have a job for you."
    },
    {
      "start": 2142.22,
      "end": 2147.54,
      "text": "And I've got a phone."
    },
    {
      "start": 2147.64,
      "end": 2151.15,
      "text": "I want to offer you this face-to-face,"
    },
    {
      "start": 2151.25,
      "end": 2156.71,
      "text": "seeing as how you might find it personal."
    },
    {
      "start": 2156.81,
      "end": 2167.45,
      "text": "Would you kill John Wick for two million dollars?"
    },
    {
      "start": 2167.55,
      "end": 2169.45,
      "text": "The contract exclusive?"
    },
    {
      "start": 2169.55,
      "end": 2170.55,
      "text": "No, it's open."
    },
    {
      "start": 2170.65,
      "end": 2171.55,
      "text": "It's a time limit."
    },
    {
      "start": 2171.65,
      "end": 2175.02,
      "text": "It has to be handed quickly."
    },
    {
      "start": 2175.12,
      "end": 2176.02,
      "text": "Consider it done."
    },
    {
      "start": 2176.12,
      "end": 2178.68,
      "text": "Thank you, Marcus."
    },
    {
      "start": 2178.78,
      "end": 2180.68,
      "text": "I trust you."
    },
    {
      "start": 2180.78,
      "end": 2182.0,
      "text": "Thanks for the drink."
    },
    {
      "start": 2205.42,
      "end": 2209.02,
      "text": "Here for the operation."
    },
    {
      "start": 2210.18,
      "end": 2214.52,
      "text": "You don't need a knife."
    },
    {
      "start": 2214.62,
      "end": 2218.56,
      "text": "Got guns."
    },
    {
      "start": 2218.66,
      "end": 2220.36,
      "text": "Got guns."
    },
    {
      "start": 2220.46,
      "end": 2222.12,
      "text": "Got guns."
    },
    {
      "start": 2222.22,
      "end": 2225.84,
      "text": "Got guns."
    },
    {
      "start": 2225.94,
      "end": 2308.75,
      "text": "Room 980, do enjoy your stay."
    },
    {
      "start": 2308.85,
      "end": 2309.75,
      "text": "Thanks."
    },
    {
      "start": 2309.85,
      "end": 2314.6,
      "text": "Good seeing you again, John."
    },
    {
      "start": 2314.7,
      "end": 2316.27,
      "text": "Perkins."
    },
    {
      "start": 2316.37,
      "end": 2320.89,
      "text": "I have you for two nights."
    },
    {
      "start": 2320.99,
      "end": 2323.96,
      "text": "Depending on business, it may be more."
    },
    {
      "start": 2324.06,
      "end": 2324.96,
      "text": "Of course, sir."
    },
    {
      "start": 2325.06,
      "end": 2326.96,
      "text": "So when did the old place get a face lift?"
    },
    {
      "start": 2327.06,
      "end": 2329.53,
      "text": "Around four years ago."
    },
    {
      "start": 2329.63,
      "end": 2331.53,
      "text": "But I assure you, sir,"
    },
    {
      "start": 2331.53,
      "end": 2333.43,
      "text": "she really hasn't changed much."
    },
    {
      "start": 2333.53,
      "end": 2334.43,
      "text": "Same owner."
    },
    {
      "start": 2334.53,
      "end": 2335.43,
      "text": "Same owner."
    },
    {
      "start": 2335.53,
      "end": 2347.61,
      "text": "It's 80."
    },
    {
      "start": 2347.71,
      "end": 2349.61,
      "text": "And as always,"
    },
    {
      "start": 2349.71,
      "end": 2354.02,
      "text": "it is a pleasure having you with us again,"
    },
    {
      "start": 2354.12,
      "end": 2370.77,
      "text": "Mr. Wick."
    },
    {
      "start": 2370.87,
      "end": 2371.77,
      "text": "What are you doing, John?"
    },
    {
      "start": 2371.87,
      "end": 2479.62,
      "text": "Now, as I recall,"
    },
    {
      "start": 2479.72,
      "end": 2482.62,
      "text": "weren't you the one tasked to dole out the beatings?"
    },
    {
      "start": 2482.72,
      "end": 2484.07,
      "text": "Don't receive them."
    },
    {
      "start": 2484.17,
      "end": 2485.07,
      "text": "Rusty, I guess."
    },
    {
      "start": 2485.17,
      "end": 2490.24,
      "text": "So what do we owe the place?"
    },
    {
      "start": 2490.34,
      "end": 2491.24,
      "text": "Yosef Tellosov."
    },
    {
      "start": 2491.34,
      "end": 2496.82,
      "text": "I'd like to talk with him."
    },
    {
      "start": 2496.92,
      "end": 2514.4,
      "text": "A talk?"
    },
    {
      "start": 2514.5,
      "end": 2521.13,
      "text": "Told this through?"
    },
    {
      "start": 2521.23,
      "end": 2522.13,
      "text": "You got out once."
    },
    {
      "start": 2522.13,
      "end": 2526.28,
      "text": "You dip so much as a pinky back into this pond."
    },
    {
      "start": 2526.38,
      "end": 2537.88,
      "text": "Where do I find him?"
    },
    {
      "start": 2537.98,
      "end": 2540.39,
      "text": "Hey, Wick's at the Continental."
    },
    {
      "start": 2540.49,
      "end": 2545.68,
      "text": "Welcome home, John."
    },
    {
      "start": 2546.52,
      "end": 2547.42,
      "text": "We have a contact there."
    },
    {
      "start": 2547.52,
      "end": 2549.42,
      "text": "It was willing to take him out for us."
    },
    {
      "start": 2549.52,
      "end": 2552.08,
      "text": "Yeah?"
    },
    {
      "start": 2552.18,
      "end": 2553.08,
      "text": "Oh, brazen."
    },
    {
      "start": 2555.9,
      "end": 2557.8,
      "text": "If they're willing to break the rules of Continental,"
    },
    {
      "start": 2557.9,
      "end": 2562.4,
      "text": "double the bounty."
    },
    {
      "start": 2562.5,
      "end": 2564.4,
      "text": "No business can be conducted on these premises"
    },
    {
      "start": 2564.5,
      "end": 2567.49,
      "text": "lest incurring heavy penalties."
    },
    {
      "start": 2567.59,
      "end": 2593.8,
      "text": "Jonathan."
    },
    {
      "start": 2593.9,
      "end": 2594.8,
      "text": "Hey, Harry."
    },
    {
      "start": 2594.9,
      "end": 2595.96,
      "text": "Oh, God."
    },
    {
      "start": 2596.06,
      "end": 2597.96,
      "text": "How long has it been?"
    },
    {
      "start": 2598.06,
      "end": 2599.0,
      "text": "Four years?"
    },
    {
      "start": 2599.0,
      "end": 2600.9,
      "text": "Five and a change."
    },
    {
      "start": 2601.06,
      "end": 2601.96,
      "text": "So shall we?"
    },
    {
      "start": 2602.06,
      "end": 2604.44,
      "text": "How was life on the other side?"
    },
    {
      "start": 2604.54,
      "end": 2605.44,
      "text": "It was good, Eddie."
    },
    {
      "start": 2605.54,
      "end": 2610.03,
      "text": "Far better than I discerned."
    },
    {
      "start": 2610.13,
      "end": 2612.03,
      "text": "Hey, I'm sorry to hear about you."
    },
    {
      "start": 2612.13,
      "end": 2613.03,
      "text": "Thanks."
    },
    {
      "start": 2613.13,
      "end": 2616.34,
      "text": "You've never seen me like this."
    },
    {
      "start": 2616.44,
      "end": 2620.31,
      "text": "Vulnerable."
    },
    {
      "start": 2620.41,
      "end": 2626.73,
      "text": "Not if you're drinking here, you're not."
    },
    {
      "start": 2626.83,
      "end": 2629.3,
      "text": "Needle?"
    },
    {
      "start": 2629.4,
      "end": 2638.56,
      "text": "Compliments to the house."
    },
    {
      "start": 2638.66,
      "end": 2705.16,
      "text": "Banja cheese stuff."
    },
    {
      "start": 2705.26,
      "end": 2706.16,
      "text": "Three o'clock."
    },
    {
      "start": 2706.26,
      "end": 2790.39,
      "text": "You have malchica."
    },
    {
      "start": 2790.49,
      "end": 2793.48,
      "text": "And your nunchucks has peanuts."
    },
    {
      "start": 2793.58,
      "end": 2795.48,
      "text": "Are you scared of the fucking boogeyman?"
    },
    {
      "start": 2795.58,
      "end": 2796.83,
      "text": "I'm not."
    },
    {
      "start": 2796.93,
      "end": 2797.83,
      "text": "No."
    },
    {
      "start": 2797.93,
      "end": 2799.7,
      "text": "But you should be."
    },
    {
      "start": 2799.8,
      "end": 2806.3,
      "text": "Another bottle!"
    },
    {
      "start": 2806.3,
      "end": 2828.07,
      "text": "The tip of the deal."
    },
    {
      "start": 2828.17,
      "end": 2830.07,
      "text": "Twenty kilograms."
    },
    {
      "start": 2830.17,
      "end": 2831.07,
      "text": "Yeah."
    },
    {
      "start": 2831.17,
      "end": 2832.07,
      "text": "For pitchy life."
    },
    {
      "start": 2832.17,
      "end": 2836.83,
      "text": "Are you here on business, sir?"
    },
    {
      "start": 2836.93,
      "end": 2839.53,
      "text": "Great show, Francis."
    },
    {
      "start": 2839.63,
      "end": 2840.53,
      "text": "Mind you take the night off."
    },
    {
      "start": 2840.63,
      "end": 2955.97,
      "text": "Thank you, sir."
    },
    {
      "start": 2956.07,
      "end": 2956.97,
      "text": "Don't worry."
    },
    {
      "start": 2957.07,
      "end": 3325.31,
      "text": "Second floor, status."
    },
    {
      "start": 3325.41,
      "end": 3326.31,
      "text": "How may I be of service?"
    },
    {
      "start": 3326.41,
      "end": 3327.31,
      "text": "He's a doctor."
    },
    {
      "start": 3327.41,
      "end": 3328.34,
      "text": "Yes, sir."
    },
    {
      "start": 3328.44,
      "end": 3329.34,
      "text": "24-7."
    },
    {
      "start": 3329.44,
      "end": 3330.34,
      "text": "Send him up, please."
    },
    {
      "start": 3330.44,
      "end": 3331.34,
      "text": "Yes, sir."
    },
    {
      "start": 3331.44,
      "end": 3332.34,
      "text": "How good's your laundry?"
    },
    {
      "start": 3332.44,
      "end": 3337.32,
      "text": "I'm sorry to say that no one's that good."
    },
    {
      "start": 3337.42,
      "end": 3339.09,
      "text": "No."
    },
    {
      "start": 3339.19,
      "end": 3340.57,
      "text": "I thought not."
    },
    {
      "start": 3340.57,
      "end": 3343.82,
      "text": "May I suggest a drink, sir?"
    },
    {
      "start": 3343.92,
      "end": 3347.42,
      "text": "Bourbon perhaps?"
    },
    {
      "start": 3347.52,
      "end": 3348.42,
      "text": "That sounds perfect."
    },
    {
      "start": 3348.52,
      "end": 3365.91,
      "text": "What sort of movement am I looking at?"
    },
    {
      "start": 3366.01,
      "end": 3368.58,
      "text": "Well, if you're looking to heal,"
    },
    {
      "start": 3368.68,
      "end": 3372.79,
      "text": "then keep it marginal."
    },
    {
      "start": 3372.89,
      "end": 3377.21,
      "text": "If you still have business to attend to,"
    },
    {
      "start": 3377.31,
      "end": 3380.49,
      "text": "take two of these beforehand."
    },
    {
      "start": 3380.59,
      "end": 3384.02,
      "text": "Your stitches will tear,"
    },
    {
      "start": 3384.12,
      "end": 3386.7,
      "text": "and you'll bleed."
    },
    {
      "start": 3386.8,
      "end": 3389.4,
      "text": "Let you'll have full function."
    },
    {
      "start": 3389.5,
      "end": 3392.62,
      "text": "Do you need anything for the pain?"
    },
    {
      "start": 3392.72,
      "end": 3393.62,
      "text": "No, I've got that covered."
    },
    {
      "start": 3393.72,
      "end": 3484.9,
      "text": "Give me four to break hotel rules."
    },
    {
      "start": 3484.9,
      "end": 3485.8,
      "text": "Why, sir?"
    },
    {
      "start": 3485.9,
      "end": 3577.33,
      "text": "You've received a number of grievances"
    },
    {
      "start": 3577.43,
      "end": 3581.48,
      "text": "from your flow concerning the noise."
    },
    {
      "start": 3581.58,
      "end": 3583.48,
      "text": "My apologies."
    },
    {
      "start": 3583.58,
      "end": 3587.74,
      "text": "I was dealing with an uninvited guest."
    },
    {
      "start": 3587.84,
      "end": 3589.96,
      "text": "How do you need Linoce?"
    },
    {
      "start": 3590.06,
      "end": 3591.96,
      "text": "A dinner reservation, perhaps?"
    },
    {
      "start": 3592.06,
      "end": 3592.96,
      "text": "Perhaps."
    },
    {
      "start": 3593.06,
      "end": 3605.17,
      "text": "I'll have to get back to you."
    },
    {
      "start": 3605.27,
      "end": 3607.17,
      "text": "Where's Yosef?"
    },
    {
      "start": 3607.69,
      "end": 3608.59,
      "text": "Where's Vigo?"
    },
    {
      "start": 3608.69,
      "end": 3610.59,
      "text": "I'm not telling you shit."
    },
    {
      "start": 3611.23,
      "end": 3621.81,
      "text": "Do you really want to die here, Perkins?"
    },
    {
      "start": 3621.81,
      "end": 3625.22,
      "text": "Little Russian church near Kinnock Court."
    },
    {
      "start": 3625.32,
      "end": 3627.54,
      "text": "What about it?"
    },
    {
      "start": 3627.64,
      "end": 3628.61,
      "text": "It's a front."
    },
    {
      "start": 3628.71,
      "end": 3630.61,
      "text": "It's where Vigo keeps his private stash."
    },
    {
      "start": 3630.71,
      "end": 3633.59,
      "text": "Thank you."
    },
    {
      "start": 3633.69,
      "end": 3644.39,
      "text": "Do I know you?"
    },
    {
      "start": 3644.49,
      "end": 3645.39,
      "text": "I'm thinking so."
    },
    {
      "start": 3645.49,
      "end": 3654.72,
      "text": "Hey, John."
    },
    {
      "start": 3654.82,
      "end": 3655.72,
      "text": "Hey, Harry."
    },
    {
      "start": 3656.4,
      "end": 3658.3,
      "text": "Everything all right?"
    },
    {
      "start": 3658.4,
      "end": 3660.03,
      "text": "Yeah."
    },
    {
      "start": 3660.13,
      "end": 3661.03,
      "text": "Everything's fine."
    },
    {
      "start": 3661.13,
      "end": 3663.8,
      "text": "Well, I'll leave you two with that."
    },
    {
      "start": 3663.9,
      "end": 3664.8,
      "text": "Hey, Harry."
    },
    {
      "start": 3664.9,
      "end": 3668.05,
      "text": "You keen on earning a coin?"
    },
    {
      "start": 3668.15,
      "end": 3670.05,
      "text": "Babies sitting to sleep in one?"
    },
    {
      "start": 3670.15,
      "end": 3671.05,
      "text": "Catch and release?"
    },
    {
      "start": 3671.15,
      "end": 3673.05,
      "text": "Catch and release."
    },
    {
      "start": 3673.05,
      "end": 3705.31,
      "text": "My son."
    },
    {
      "start": 3705.41,
      "end": 3706.31,
      "text": "How might I help you?"
    },
    {
      "start": 3706.41,
      "end": 3714.9,
      "text": "Motherfucker!"
    },
    {
      "start": 3715.0,
      "end": 3716.9,
      "text": "There's an Irish Nagavok Deepryosh."
    },
    {
      "start": 3717.0,
      "end": 3721.46,
      "text": "Ah, there's an Ion."
    },
    {
      "start": 3721.56,
      "end": 3723.46,
      "text": "Ah!"
    },
    {
      "start": 3723.56,
      "end": 3726.96,
      "text": "Let's go to the vault."
    },
    {
      "start": 3727.06,
      "end": 3728.89,
      "text": "Ah!"
    },
    {
      "start": 3728.99,
      "end": 3739.91,
      "text": "Open it."
    },
    {
      "start": 3740.01,
      "end": 3744.0,
      "text": "Just don't do an Irish to mean your motion's as stifled as a creed."
    },
    {
      "start": 3744.1,
      "end": 3746.0,
      "text": "Don't, my guru."
    },
    {
      "start": 3746.1,
      "end": 3747.84,
      "text": "Code."
    },
    {
      "start": 3747.94,
      "end": 3766.92,
      "text": "Vigo will kill me."
    },
    {
      "start": 3767.02,
      "end": 3767.92,
      "text": "Ladies."
    },
    {
      "start": 3768.02,
      "end": 3773.53,
      "text": "Oh."
    },
    {
      "start": 3773.63,
      "end": 3774.53,
      "text": "Russian in here."
    },
    {
      "start": 3774.63,
      "end": 3782.35,
      "text": "Honestly."
    },
    {
      "start": 3782.35,
      "end": 3785.25,
      "text": "What do you think you're going to do with all of that?"
    },
    {
      "start": 3785.35,
      "end": 3786.25,
      "text": "This."
    },
    {
      "start": 3786.35,
      "end": 3836.59,
      "text": "Don't worry."
    },
    {
      "start": 3836.69,
      "end": 3840.1,
      "text": "Housekeeping will find you."
    },
    {
      "start": 3840.2,
      "end": 3842.86,
      "text": "Treat all your ladies like this?"
    },
    {
      "start": 3842.96,
      "end": 3845.86,
      "text": "You are no lady."
    },
    {
      "start": 3845.96,
      "end": 3846.86,
      "text": "Trust me."
    },
    {
      "start": 3853.52,
      "end": 3855.42,
      "text": "Harry, is it?"
    },
    {
      "start": 3857.7,
      "end": 3859.6,
      "text": "How would you like to earn more than just a gold coin?"
    },
    {
      "start": 3859.7,
      "end": 3865.09,
      "text": "You've broken the rules."
    },
    {
      "start": 3865.19,
      "end": 3868.09,
      "text": "You've done business on continental grounds."
    },
    {
      "start": 3868.19,
      "end": 3883.84,
      "text": "And management does not take kindly to that sort of behavior."
    },
    {
      "start": 3883.94,
      "end": 3885.06,
      "text": "Don't worry."
    },
    {
      "start": 3885.16,
      "end": 3892.95,
      "text": "Housekeeping will find you."
    },
    {
      "start": 3893.05,
      "end": 3896.1,
      "text": "Ashes to ashes."
    },
    {
      "start": 3896.2,
      "end": 3897.1,
      "text": "Can we recall it for this?"
    },
    {
      "start": 3897.2,
      "end": 3899.1,
      "text": "Vigo, you know what was in that vault, right?"
    },
    {
      "start": 3899.2,
      "end": 4002.12,
      "text": "It's not..."
    },
    {
      "start": 4002.22,
      "end": 4005.14,
      "text": "I say this, John."
    },
    {
      "start": 4005.24,
      "end": 4010.0,
      "text": "The surest fuck broke the mold with you."
    },
    {
      "start": 4010.1,
      "end": 4021.79,
      "text": "Hi, hi."
    },
    {
      "start": 4021.89,
      "end": 4035.02,
      "text": "You always had a certain, you know, audacity about it."
    },
    {
      "start": 4035.12,
      "end": 4040.1,
      "text": "You say you're still very much the John Wick of all."
    },
    {
      "start": 4040.2,
      "end": 4044.59,
      "text": "And why?"
    },
    {
      "start": 4044.69,
      "end": 4046.59,
      "text": "People don't change."
    },
    {
      "start": 4046.69,
      "end": 4047.59,
      "text": "You know that."
    },
    {
      "start": 4048.49,
      "end": 4054.68,
      "text": "Times they do."
    },
    {
      "start": 4054.68,
      "end": 4056.58,
      "text": "You know what was in that vault?"
    },
    {
      "start": 4056.68,
      "end": 4060.03,
      "text": "Art were cash, not without this worth,"
    },
    {
      "start": 4060.13,
      "end": 4063.03,
      "text": "but the leverage I had on this city."
    },
    {
      "start": 4063.13,
      "end": 4068.03,
      "text": "Audio recordings, physical evidence, black men was fucking priceless."
    },
    {
      "start": 4069.34,
      "end": 4073.1,
      "text": "Paiseless."
    },
    {
      "start": 4073.2,
      "end": 4076.61,
      "text": "Yeah, I kind of enjoyed doing it."
    },
    {
      "start": 4076.71,
      "end": 4079.8,
      "text": "Yeah, yeah, I know you did."
    },
    {
      "start": 4079.9,
      "end": 4083.28,
      "text": "Yeah, you did that."
    },
    {
      "start": 4090.57,
      "end": 4097.12,
      "text": "So, ah, there you got married, huh?"
    },
    {
      "start": 4097.12,
      "end": 4099.82,
      "text": "Well, you managed that anyways."
    },
    {
      "start": 4099.92,
      "end": 4102.39,
      "text": "Not good, yes."
    },
    {
      "start": 4102.49,
      "end": 4108.53,
      "text": "Yeah, well, you had your wife, I had my son,"
    },
    {
      "start": 4108.63,
      "end": 4112.53,
      "text": "and believe me, you had a far better deal."
    },
    {
      "start": 4112.63,
      "end": 4121.3,
      "text": "And there you left, and the way you got out,"
    },
    {
      "start": 4121.4,
      "end": 4126.3,
      "text": "lying to yourself that the past held no sway over the future,"
    },
    {
      "start": 4126.4,
      "end": 4129.3,
      "text": "but in the end,"
    },
    {
      "start": 4130.45,
      "end": 4135.35,
      "text": "a lot of us are rewarded for our misdeeds,"
    },
    {
      "start": 4135.35,
      "end": 4141.68,
      "text": "which is why God took your wife, and leased you."
    },
    {
      "start": 4141.78,
      "end": 4175.56,
      "text": "Finally, common ground."
    },
    {
      "start": 4175.66,
      "end": 4179.56,
      "text": "Step aside, give me your son."
    },
    {
      "start": 4179.66,
      "end": 4192.36,
      "text": "It was just a fucking car, just a fucking dog."
    },
    {
      "start": 4192.46,
      "end": 4195.32,
      "text": "Just a dog."
    },
    {
      "start": 4195.42,
      "end": 4199.64,
      "text": "Be gone."
    },
    {
      "start": 4199.74,
      "end": 4201.64,
      "text": "Then died, I lost everything,"
    },
    {
      "start": 4201.74,
      "end": 4205.51,
      "text": "until that dog arrived on my doorstep."
    },
    {
      "start": 4205.61,
      "end": 4209.31,
      "text": "A final gift for my wife."
    },
    {
      "start": 4209.41,
      "end": 4212.31,
      "text": "In that moment, I received some semblance of hope."
    },
    {
      "start": 4212.31,
      "end": 4220.55,
      "text": "An opportunity to grieve unlawful."
    },
    {
      "start": 4220.65,
      "end": 4227.65,
      "text": "And your son stole that from me."
    },
    {
      "start": 4227.75,
      "end": 4229.65,
      "text": "Killed that from me!"
    },
    {
      "start": 4229.75,
      "end": 4232.84,
      "text": "People keep asking if I'm back,"
    },
    {
      "start": 4232.94,
      "end": 4235.84,
      "text": "and I haven't really had an answer."
    },
    {
      "start": 4235.94,
      "end": 4238.84,
      "text": "But now, yeah, I'm thinking I'm back,"
    },
    {
      "start": 4238.94,
      "end": 4241.84,
      "text": "so you can either hand over your son,"
    },
    {
      "start": 4241.94,
      "end": 4246.84,
      "text": "or you can die screaming alongside him!"
    },
    {
      "start": 4246.94,
      "end": 4422.97,
      "text": "If I tell you where he is, you let me walk away."
    },
    {
      "start": 4422.97,
      "end": 4424.93,
      "text": "Pull the contract."
    },
    {
      "start": 4425.03,
      "end": 4437.5,
      "text": "Don, he's kept in a safe house,"
    },
    {
      "start": 4437.6,
      "end": 4440.5,
      "text": "Brooklyn, 434 Wallace Place."
    },
    {
      "start": 4440.6,
      "end": 4444.64,
      "text": "They know you're coming."
    },
    {
      "start": 4444.74,
      "end": 4445.64,
      "text": "Of course."
    },
    {
      "start": 4446.29,
      "end": 4480.57,
      "text": "But it won't matter."
    },
    {
      "start": 4480.67,
      "end": 4500.71,
      "text": "Get off."
    },
    {
      "start": 4500.81,
      "end": 4510.44,
      "text": "Stop playing a fucking game."
    },
    {
      "start": 4510.54,
      "end": 4643.76,
      "text": "Prio."
    },
    {
      "start": 4643.86,
      "end": 4644.76,
      "text": "Our pleasure, sir."
    },
    {
      "start": 4644.86,
      "end": 4651.32,
      "text": "A parting gift from the management."
    },
    {
      "start": 4651.42,
      "end": 4656.88,
      "text": "Compensation for last night's unfortunate incident."
    },
    {
      "start": 4656.98,
      "end": 4706.88,
      "text": "What times do I have to save you, man?"
    },
    {
      "start": 4706.98,
      "end": 4708.65,
      "text": "I appreciate it."
    },
    {
      "start": 4708.75,
      "end": 4712.44,
      "text": "Say, you look terrible."
    },
    {
      "start": 4712.44,
      "end": 4714.34,
      "text": "No, I look retired."
    },
    {
      "start": 4714.76,
      "end": 4715.66,
      "text": "Retired?"
    },
    {
      "start": 4715.76,
      "end": 4717.89,
      "text": "You really believe that?"
    },
    {
      "start": 4717.99,
      "end": 4733.86,
      "text": "No life?"
    },
    {
      "start": 4733.96,
      "end": 4737.58,
      "text": "Find a way back to it."
    },
    {
      "start": 4737.68,
      "end": 4740.89,
      "text": "Time to go home."
    },
    {
      "start": 4740.99,
      "end": 4796.35,
      "text": "What's wrong with this?"
    },
    {
      "start": 4796.45,
      "end": 4798.82,
      "text": "This is."
    },
    {
      "start": 4798.92,
      "end": 4813.91,
      "text": "Hello, Marcus."
    },
    {
      "start": 4814.01,
      "end": 4814.91,
      "text": "This is John."
    },
    {
      "start": 4815.01,
      "end": 4820.03,
      "text": "I appreciate you granted my son a Swiss death."
    },
    {
      "start": 4822.18,
      "end": 4825.08,
      "text": "I wouldn't know how to reply to that, either."
    },
    {
      "start": 4825.18,
      "end": 4828.49,
      "text": "Marcus betrayed me."
    },
    {
      "start": 4828.59,
      "end": 4843.9,
      "text": "And while it was open,"
    },
    {
      "start": 4844.0,
      "end": 4845.9,
      "text": "you had every chance,"
    },
    {
      "start": 4846.0,
      "end": 4850.38,
      "text": "every opportunity to kill John Wick."
    },
    {
      "start": 4850.48,
      "end": 4853.38,
      "text": "And if you have done your job,"
    },
    {
      "start": 4853.48,
      "end": 4856.38,
      "text": "my son would be still alive."
    },
    {
      "start": 4856.48,
      "end": 4860.17,
      "text": "And in so doing,"
    },
    {
      "start": 4860.27,
      "end": 4862.17,
      "text": "he broke the card and on a roll."
    },
    {
      "start": 4862.27,
      "end": 4870.8,
      "text": "Thank you, Miss Bergens."
    },
    {
      "start": 4872.56,
      "end": 4873.46,
      "text": "Am I not surprised?"
    },
    {
      "start": 4874.72,
      "end": 4876.62,
      "text": "In for a penny, in for a pound."
    },
    {
      "start": 4876.72,
      "end": 4881.12,
      "text": "So, John, I had no choice."
    },
    {
      "start": 4881.22,
      "end": 4884.95,
      "text": "I always liked you, Marcus."
    },
    {
      "start": 4886.72,
      "end": 4911.89,
      "text": "I stole the whole card, but on my own."
    },
    {
      "start": 4966.42,
      "end": 4967.32,
      "text": "Fuel the chopper."
    },
    {
      "start": 4967.32,
      "end": 5043.35,
      "text": "Your membership to the continental has been by thine own hand."
    },
    {
      "start": 5043.45,
      "end": 5044.35,
      "text": "Revoked."
    },
    {
      "start": 5044.45,
      "end": 5075.7,
      "text": "I'm thinking, Jonathan, we live by a code."
    },
    {
      "start": 5075.8,
      "end": 5077.7,
      "text": "Which is why I'm not the one telling you"
    },
    {
      "start": 5077.8,
      "end": 5078.7,
      "text": "it was a certain helicopter"
    },
    {
      "start": 5078.8,
      "end": 5080.7,
      "text": "to a certain helipad is being fueled"
    },
    {
      "start": 5080.8,
      "end": 5082.7,
      "text": "for a certain someone."
    },
    {
      "start": 5082.8,
      "end": 5102.23,
      "text": "You got my cigarettes?"
    },
    {
      "start": 5102.33,
      "end": 5104.23,
      "text": "Yeah, I got your cigarettes."
    },
    {
      "start": 5104.33,
      "end": 5126.9,
      "text": "Tour at the dynamier."
    },
    {
      "start": 5127.0,
      "end": 5129.51,
      "text": "Oh, fuck."
    },
    {
      "start": 5129.61,
      "end": 5133.23,
      "text": "Yeah, super."
    },
    {
      "start": 5133.33,
      "end": 5134.23,
      "text": "Come on, let's go faster."
    },
    {
      "start": 5134.33,
      "end": 5135.23,
      "text": "Helicopter's right down there."
    },
    {
      "start": 5135.33,
      "end": 5136.23,
      "text": "Come on, let's go."
    },
    {
      "start": 5136.33,
      "end": 5150.22,
      "text": "Shit."
    },
    {
      "start": 5150.32,
      "end": 5152.22,
      "text": "God damn, I knew he'd come."
    },
    {
      "start": 5152.22,
      "end": 5168.65,
      "text": "Fucking wrong with this guy."
    },
    {
      "start": 5168.75,
      "end": 5169.71,
      "text": "Somebody give me a gun."
    },
    {
      "start": 5169.81,
      "end": 5175.17,
      "text": "Who's got a gun?"
    },
    {
      "start": 5175.27,
      "end": 5178.17,
      "text": "That was a good one."
    },
    {
      "start": 5178.36,
      "end": 5179.26,
      "text": "Who's got a gun?"
    },
    {
      "start": 5179.36,
      "end": 5193.2,
      "text": "Double chop over here."
    },
    {
      "start": 5193.3,
      "end": 5215.49,
      "text": "Look at the helicopter's right over there."
    },
    {
      "start": 5215.59,
      "end": 5216.49,
      "text": "We have to go over there."
    },
    {
      "start": 5216.59,
      "end": 5234.93,
      "text": "My guy knew a gun."
    },
    {
      "start": 5235.03,
      "end": 5250.68,
      "text": "Push it."
    },
    {
      "start": 5250.78,
      "end": 5258.54,
      "text": "English, please."
    },
    {
      "start": 5258.64,
      "end": 5259.54,
      "text": "Good luck."
    },
    {
      "start": 5259.64,
      "end": 5263.72,
      "text": "Russian cock sucker."
    },
    {
      "start": 5263.82,
      "end": 5357.69,
      "text": "No more guns, John."
    },
    {
      "start": 5357.79,
      "end": 5361.83,
      "text": "No more bullets."
    },
    {
      "start": 5362.92,
      "end": 5372.79,
      "text": "No more bullets."
    },
    {
      "start": 5372.89,
      "end": 5375.53,
      "text": "Just you and me, John."
    },
    {
      "start": 5375.63,
      "end": 5376.53,
      "text": "You and me."
    },
    {
      "start": 5376.63,
      "end": 5402.02,
      "text": "What happened, John?"
    },
    {
      "start": 5402.63,
      "end": 5404.53,
      "text": "We were professionals."
    },
    {
      "start": 5404.63,
      "end": 5405.53,
      "text": "Civilized."
    },
    {
      "start": 5405.63,
      "end": 5407.53,
      "text": "Do I look civilized to you?"
    }
  ]
}