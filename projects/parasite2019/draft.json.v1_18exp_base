      ],
      "clip_start": "01:27:30.0",
      "clip_end": "01:27:42.0",
      "narration": "It is said almost gently, as a small private joke between husband and wife. But Ki-taek, lying in the dark beneath them, hears exactly where that line is drawn - and that no amount of clever lying will ever move him to the other side of it.",
      "claim": {
        "type": "reaction",
        "requires_visual": true,
        "subject": "Ki-taek"
