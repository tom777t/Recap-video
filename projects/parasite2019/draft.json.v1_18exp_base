      ],
      "clip_start": "00:07:18.0",
      "clip_end": "00:07:30.0",
      "narration": "Then Ki-woo's old college friend Min drops by, carrying an unusual gift: a scholar's rock, a smooth grey viewing stone the wealthy like to keep on a shelf because it is supposed to draw money and good fortune to the home.",
      "claim": {
        "type": "reveal",
        "requires_visual": true,
        "subject": "Min"
