      ],
      "clip_start": "00:08:50.0",
      "clip_end": "00:09:00.0",
      "narration": "Min is going abroad to study, and he passes Ki-woo a golden opportunity - his own tutoring job, teaching English to the teenage daughter of a wealthy family up the hill, the Parks.",
      "claim": {
        "type": "dialogue",
        "requires_visual": true,
        "subject": "Min"
