      ],
      "clip_start": "00:37:50.0",
      "clip_end": "00:37:55.0",
      "narration": "And just like that, the father becomes their driver.",
      "claim": {
        "type": "dialogue",
        "requires_visual": true,
        "subject": "Ki-taek"
      }
    },
    {
      "id": 22,
      "line_id": "L22",
      "unit_id": "U06",
      "covers": [
        "7"
      ],
      "clip_start": "00:39:55.0",
      "clip_end": "00:40:05.0",
      "narration": "Only the loyal old housekeeper Moon-gwang now stands in their way. But the Kims discover she is hiding one dangerous secret weakness: a severe allergy to peaches.",
      "claim": {
        "type": "setup",
        "requires_visual": true,
        "subject": "Ki-taek"
