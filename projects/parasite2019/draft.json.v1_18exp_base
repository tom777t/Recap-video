      "clip_start": "00:14:30.0",
      "clip_end": "00:14:34.0",
      "narration": "Calling himself Kevin, he charms Mrs Park, the warm and trusting lady of the house.",
      "claim": {
        "type": "dialogue",
        "requires_visual": true,
        "subject": "Ki-woo"
      }
    },
    {
      "id": 12,
      "line_id": "L12",
      "unit_id": "U04",
      "covers": [
