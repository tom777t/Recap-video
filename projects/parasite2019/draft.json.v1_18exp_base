      "covers": [
        "5"
      ],
      "clip_start": "00:17:55.0",
      "clip_end": "00:18:05.0",
      "narration": "He meets the Parks' hyperactive young son, Da-song - a boy who plays at being a cowboy and an Indian, and whom the family treats as a fragile little artistic genius.",
      "claim": {
        "type": "setup",
        "requires_visual": true,
