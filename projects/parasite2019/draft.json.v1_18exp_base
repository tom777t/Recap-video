      "claim": {
        "type": "dialogue",
        "requires_visual": true,
        "subject": "Ki-woo"
      }
    },
    {
      "id": 13,
      "line_id": "L13",
      "unit_id": "U04",
      "covers": [
        "4"
      ],
      "clip_start": "00:16:40.0",
      "clip_end": "00:16:46.0",
      "narration": "The lesson is really a performance of swagger - and the lonely teenage girl is visibly, instantly charmed by her new tutor.",
      "claim": {
        "type": "dialogue",
        "requires_visual": true,
        "subject": "Ki-woo"
      }
    },
    {
      "id": 14,
      "line_id": "L14",
