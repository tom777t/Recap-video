# Media & heavy derived artifacts (keep on disk, not in git)
*.mp4
*.mp3
*.wav
*.jpg
*.jpeg
*.png
*.ass
# Per-project derived/temp output
projects/*/_work/
projects/*/_clipcache/
projects/*/frames/
projects/*/narration/_cache.json
projects/*/transcript.partial.jsonl
projects/*/audio16k.wav
# Python
__pycache__/
*.pyc
# Stray logs
*.log
# Backups
pipeline_backup_*/
*_backup
# local work
projects/
transcript*.txt
transcript*.json3


# --- keep the small artefacts under projects/ -------------------------------
# source.mp4, clips and frames are big and re-derivable. shots.json,
# draft.json and beats_proposal.md are neither: they hold the hand tagging,
# the beat maps and the narration - a year of work that exists nowhere else.
# A stale description after a hand-fixed window cost most of a day in Aug 2026
# precisely because nothing recorded when the window moved or why.
!projects/
!projects/*/
!projects/*/*.json
!projects/*/*.md
projects/*/_cuts.json
projects/*/timeline.json
projects/*/_vision_truth.json
projects/*/spans.json

# Scratch projects created by tools/gate_selftest.py on every run. They are
# regenerated by the test itself, so tracking them would commit test fixtures
# that go stale the moment a test changes.
projects/_selftest_*/

# Third-party reference material: auto-captions from other people's YouTube
# videos, pulled for voice analysis. This repo is PUBLIC and this text is
# someone else's copyright - it is studied locally and never committed.
references/

# Voice-test renders: regenerable audio artifacts (tools/voice_test.py), and
# this repo is PUBLIC. Kept on disk for listening, never committed.
voice_test/
