# Media & heavy derived artifacts (keep on disk, not in git)
*.mp4
*.mp3
*.wav
*.jpg
*.jpeg
*.png
*.ass
# Per-project derived/temp output
projects/*/_work/
projects/*/_clipcache/
projects/*/frames/
projects/*/narration/_cache.json
projects/*/transcript.partial.jsonl
projects/*/audio16k.wav
# Python
__pycache__/
*.pyc
# Stray logs
*.log
# Backups
pipeline_backup_*/
*_backup
# local work
projects/
transcript*.txt
transcript*.json3


# --- keep the small artefacts under projects/ -------------------------------
# source.mp4, clips and frames are big and re-derivable. shots.json,
# draft.json and beats_proposal.md are neither: they hold the hand tagging,
# the beat maps and the narration - a year of work that exists nowhere else.
# A stale description after a hand-fixed window cost most of a day in Aug 2026
# precisely because nothing recorded when the window moved or why.
!projects/
!projects/*/
!projects/*/*.json
!projects/*/*.md
projects/*/_cuts.json
projects/*/timeline.json
projects/*/_vision_truth.json
projects/*/spans.json

# Scratch projects created by tools/gate_selftest.py on every run. They are
# regenerated by the test itself, so tracking them would commit test fixtures
# that go stale the moment a test changes.
projects/_selftest_*/

# Third-party reference material: auto-captions from other people's YouTube
# videos, pulled for voice analysis. This repo is PUBLIC and this text is
# someone else's copyright - it is studied locally and never committed.
references/

projects/*/_briefs/

# Demucs stems: a full-length no-vocals wav is ~1 GB and is regenerable from
# source.mp4 with `python -m pipeline.stems --project NAME`. Never commit it.
projects/*/stems/
# Loudness-normalised music cache: uncompressed wavs (135 MB on tokyodrift2006)
# regenerated on demand from the music/ sources by pipeline.music.normalized().
# The sidecar .json next to each one records what was measured and applied, so
# nothing about the decision is lost by not committing the audio.
projects/*/music/_norm/
# Scratch commit-message files
_c.txt
_commitmsg.txt

# Phase 1 render-speed benchmark scratch: saved baseline final.mp4 and report,
# plus the pre-edit draft backup. Large, regenerable, measurement-local.
projects/*/_bench/
projects/*/draft_before_3line_edit.json
projects/*/_work_cal/
